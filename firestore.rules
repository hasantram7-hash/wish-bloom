rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /birthdaySurprises/{surpriseId} {
      // Allow everyone to read surprises (recipients, friends, creators)
      allow read: if true;

      // Allow creating surprises without login wall
      allow create: if true;

      // Allow updates (reactions, view counts, creator edits)
      allow update: if true;

      // Allow delete
      allow delete: if true;

      // Guestbook subcollection
      match /guestbook/{entryId} {
        allow read, create, update, delete: if true;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
